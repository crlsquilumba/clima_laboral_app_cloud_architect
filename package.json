{
  "name": "clima-laboral-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@clima-laboral/web",
    "build:web": "npm run build --workspace=@clima-laboral/web",
    "dev:mobile": "npm run dev --workspace=@clima-laboral/mobile",
    "build:mobile": "npm run build --workspace=@clima-laboral/mobile",
    "build:shared": "npm run build --workspace=@clima-laboral/shared",
    "build:ui": "npm run build --workspace=@clima-laboral/ui",
    "build:types": "npm run build --workspace=@clima-laboral/types",
    "build:all": "npm run build --workspaces",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
